# 复制为 .env 后填写；.env 含密钥，不要提交到 Git
# MySQL 应用账号与库名
MYSQL_DATABASE=zhixing_training
MYSQL_USER=training_app
MYSQL_PASSWORD=replace-with-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-long-random-password

# 至少 32 字节随机数的 Base64
# 生成示例：python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TRAINING_JWT_SECRET=replace-with-base64-32-bytes

# 对外访问地址，用于 CORS、证书二维码和激活链接
PUBLIC_ORIGIN=http://203.0.113.10

# HTTPS 未启用时必须是 false，否则浏览器不会回传 HttpOnly 刷新 Cookie
COOKIE_SECURE=false

# 宿主机监听端口（80 被云厂商拦截时使用 ALT_HTTP_PORT）
HTTP_PORT=80
ALT_HTTP_PORT=8091

TZ=Asia/Shanghai
TRAINING_CERTIFICATE_TIME_ZONE=Asia/Shanghai
